# Public application
PUBLIC_URL=https://launch-window.example.com
APP_PORT=8080

# MySQL
MYSQL_DATABASE=launch_window
MYSQL_USER=launch_window_user
MYSQL_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# JWT
JWT_SECRET=replace_with_base64_encoded_32_byte_secret
JWT_EXPIRATION=PT2H

# HTTP clients
HTTP_CLIENT_CONNECT_TIMEOUT=5s
HTTP_CLIENT_READ_TIMEOUT=30s

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@launch-window.example.com

# Password reset
PASSWORD_RESET_EXPIRATION=PT30M
PASSWORD_RESET_REQUEST_COOLDOWN=PT1M

# Scheduled synchronization
LAUNCH_SYNC_ENABLED=true
WEATHER_SYNC_ENABLED=true
