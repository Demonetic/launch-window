@baseUrl = http://localhost:8080
@mailpitUrl = http://localhost:8025
@initialPassword = TestPassword123!
@newPassword = ResetPassword456!

###############################################################################
# AUTHENTICATION
###############################################################################

### Register unique test account
< {%
    const suffix = Date.now().toString();

    client.global.set("test_username", "http_client_" + suffix);
    client.global.set("test_email", "http-client-" + suffix + "@example.com");
%}

POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "{{test_username}}",
  "email": "{{test_email}}",
  "password": "{{initialPassword}}"
}

> {%
    client.test("Account was registered", function () {
        client.assert(response.status === 201, "Expected registration to return 201");
    });

    if (response.status === 201) {
        client.global.set("test_user_id", response.body.id);
    }
%}

### Login with generated username
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "{{test_username}}",
  "password": "{{initialPassword}}"
}

> {%
    client.test("Login succeeded", function () {
        client.assert(response.status === 200, "Expected login to return 200");
    });

    if (response.status === 200) {
        client.global.set("auth_token", response.body.accessToken);
    }
%}

### Login with generated email
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "{{test_email}}",
  "password": "{{initialPassword}}"
}

> {%
    if (response.status === 200) {
        client.global.set("auth_token", response.body.accessToken);
    }
%}

### Current authenticated user
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{auth_token}}

###############################################################################
# PROFILE AND AVATAR
###############################################################################

### Update avatar
PATCH {{baseUrl}}/api/users/me/avatar
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "avatarKey": "ALIEN",
  "avatarColor": "#7DE2A8"
}

### Confirm updated profile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{auth_token}}

###############################################################################
# PUBLIC LAUNCH DATA
###############################################################################

### Upcoming launches and automatically select the first launch
GET {{baseUrl}}/api/launches?limit=20&sort=SOONEST

> {%
    const items = response.body.items ?? [];

    client.test("Upcoming launches were returned", function () {
        client.assert(response.status === 200, "Expected launches to return 200");
        client.assert(items.length > 0, "At least one launch is required for later requests");
    });

    if (items.length > 0) {
        client.global.set("launch_id", items[0].id);
    }
%}

### Browse launches with filters
GET {{baseUrl}}/api/launches?limit=20&sort=BEST_VIEWING&days=30&statuses=GO,TO_BE_CONFIRMED&forecastAvailable=true&minimumViewingScore=40

### Search launches
GET {{baseUrl}}/api/launches?limit=20&query=Falcon

### Available launch countries
GET {{baseUrl}}/api/launches/countries

### Best viewing conditions
GET {{baseUrl}}/api/launches/best-viewing?days=7&limit=3

### Selected launch details
GET {{baseUrl}}/api/launches/{{launch_id}}

### Selected launch weather
GET {{baseUrl}}/api/launches/{{launch_id}}/weather

###############################################################################
# CALENDAR
###############################################################################

### Initial calendar page
GET {{baseUrl}}/api/calendar?limit=20
Authorization: Bearer {{auth_token}}

### Save selected launch to calendar
PUT {{baseUrl}}/api/calendar/{{launch_id}}
Authorization: Bearer {{auth_token}}

### Check which launch IDs are saved
GET {{baseUrl}}/api/calendar/saved-launch-ids?launchIds={{launch_id}}
Authorization: Bearer {{auth_token}}

### Confirm saved launch in calendar
GET {{baseUrl}}/api/calendar?limit=20
Authorization: Bearer {{auth_token}}

### Pending calendar invitations
GET {{baseUrl}}/api/calendar/invitations/pending
Authorization: Bearer {{auth_token}}

### Remove selected launch from calendar
DELETE {{baseUrl}}/api/calendar/{{launch_id}}
Authorization: Bearer {{auth_token}}

### Save it again so account deletion later tests database cascade
PUT {{baseUrl}}/api/calendar/{{launch_id}}
Authorization: Bearer {{auth_token}}

###############################################################################
# NOTES
###############################################################################

### Notes overview
GET {{baseUrl}}/api/notes?limit=20
Authorization: Bearer {{auth_token}}

### Notes connected to selected launch
GET {{baseUrl}}/api/launches/{{launch_id}}/notes
Authorization: Bearer {{auth_token}}

### Create launch note and save its ID automatically
POST {{baseUrl}}/api/launches/{{launch_id}}/notes
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "content": "Watch the cloud cover before launch."
}

> {%
    client.test("Note was created", function () {
        client.assert(response.status === 201,"Expected note creation to return 201");
    });

    if (response.status === 201) {
        client.global.set("note_id",response.body.id);
    }
%}

### Update created note
PUT {{baseUrl}}/api/notes/{{note_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "content": "Updated note from IntelliJ HTTP Client."
}

### Confirm updated note
GET {{baseUrl}}/api/launches/{{launch_id}}/notes
Authorization: Bearer {{auth_token}}

### Delete created note
DELETE {{baseUrl}}/api/notes/{{note_id}}
Authorization: Bearer {{auth_token}}

### Create another note that account deletion should remove
POST {{baseUrl}}/api/launches/{{launch_id}}/notes
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "content": "This note should disappear when the account is deleted."
}

###############################################################################
# PASSWORD RESET THROUGH MAILPIT
###############################################################################

### Empty Mailpit before password reset test
DELETE {{mailpitUrl}}/api/v1/messages

### Request password reset for generated account
POST {{baseUrl}}/api/auth/password/forgot
Content-Type: application/json

{
  "email": "{{test_email}}"
}

> {%
    client.test("Password reset request was accepted", function () {
        client.assert(response.status === 204,"Expected password reset request to return 204");
    });
%}

### Request again during cooldown - should still return 204 but send no second email
POST {{baseUrl}}/api/auth/password/forgot
Content-Type: application/json

{
  "email": "{{test_email}}"
}

### List Mailpit messages and capture newest message ID
GET {{mailpitUrl}}/api/v1/messages

> {%
    const messages =response.body.messages ?? response.body.Messages ?? [];

    client.test("Exactly one reset email was received", function () {
        client.assert(messages.length === 1,"Expected one email because the second request is inside cooldown");
    });

    if (messages.length > 0) {
        const messageId = messages[0].ID ?? messages[0].id;

        client.global.set("mail_message_id",messageId);
    }
%}

### Read reset email and extract token automatically
GET {{mailpitUrl}}/api/v1/message/{{mail_message_id}}

> {%
    const text = response.body.Text ?? response.body.text ?? JSON.stringify(response.body);

    const tokenMatch = text.match(/token=([A-Za-z0-9_-]+)/);

    client.test("Reset token exists in email", function () {
        client.assert(tokenMatch !== null, "Could not find reset token in Mailpit message");
    });

    if (tokenMatch !== null) {
        client.global.set("reset_token", tokenMatch[1]);
    }
%}

### Reset password using token extracted from Mailpit
POST {{baseUrl}}/api/auth/password/reset
Content-Type: application/json

{
  "token": "{{reset_token}}",
  "newPassword": "{{newPassword}}"
}

> {%
    client.test("Password was reset", function () {
        client.assert(response.status === 204, "Expected password reset to return 204");
    });
%}

### Old password should no longer work
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "{{test_username}}",
  "password": "{{initialPassword}}"
}

> {%
    client.test("Old password was rejected", function () {
        client.assert(response.status === 401, "Expected old password to return 401");
    });
%}

### Login using new password and replace auth token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "{{test_username}}",
  "password": "{{newPassword}}"
}

> {%
    client.test("New password works", function () {
        client.assert(response.status === 200, "Expected new password login to return 200");
    });

    if (response.status === 200) {
        client.global.set("auth_token", response.body.accessToken);
    }
%}

### Reusing reset token should fail
POST {{baseUrl}}/api/auth/password/reset
Content-Type: application/json

{
  "token": "{{reset_token}}",
  "newPassword": "AnotherPassword789!"
}

> {%
    client.test("Used reset token was rejected", function () {
        client.assert(response.status === 400, "Expected reused token to return 400");
        client.assert(response.body.code === "INVALID_PASSWORD_RESET_TOKEN", "Expected INVALID_PASSWORD_RESET_TOKEN");
    });
%}

### Unknown email returns same response without sending email
POST {{baseUrl}}/api/auth/password/forgot
Content-Type: application/json

{
  "email": "does-not-exist@example.com"
}

> {%
    client.test("Unknown email does not reveal account existence", function () {
        client.assert(response.status === 204, "Expected unknown email to return 204");
    });
%}

### Confirm unknown email did not create another message
GET {{mailpitUrl}}/api/v1/messages

> {%
    const messages = response.body.messages ?? response.body.Messages ?? [];

    client.test("Unknown email did not send mail", function () {
        client.assert(messages.length === 1, "Expected Mailpit to still contain only the original email");
    });
%}

