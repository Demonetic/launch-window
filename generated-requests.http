{
  "username": "a",
  "email": "invalid",
  "password": "short"
}

### Invalid login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "missing",
  "password": "wrong-password"
}

### Protected endpoint without token
GET {{baseUrl}}/api/calendar

### Invalid launch pagination
GET {{baseUrl}}/api/launches?afterTime=2026-08-01T12:00:00Z

### Invalid password reset token
POST {{baseUrl}}/api/auth/password/reset
Content-Type: application/json

{
  "token": "invalid-token",
  "newPassword": "ValidPassword123!"
}

###############################################################################
# ACCOUNT DELETION
#
# RUN THIS LAST.
# It permanently deletes the generated test account and its remaining data.
###############################################################################

### Permanently delete generated account
DELETE {{baseUrl}}/api/users/me
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "password": "{{newPassword}}"
}

> {%
    client.test("Account was deleted", function () {
        client.assert(response.status === 204, "Expected account deletion to return 204");
    });

    if (response.status === 204) {
        client.global.clear("auth_token");
        client.global.clear("test_user_id");
        client.global.clear("note_id");
        client.global.clear("launch_id");
        client.global.clear("reset_token");
        client.global.clear("mail_message_id");
    }
%}

### Deleted account can no longer log in
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "{{test_username}}",
  "password": "{{newPassword}}"
}

> {%
    client.test("Deleted account login was rejected", function () {
        client.assert(response.status === 401, "Expected deleted account login to return 401");
    });
%}